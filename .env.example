# 复制为 .env 后填入自己的 key(.env 已在 .gitignore 中)
DEEPSEEK_API_KEY=sk-your-key-here

# 可选:大模型思考强度 none / low / high
LLM_EFFORT=low

# JWT 登录(部署时务必修改)
APP_USER=admin
APP_PASSWORD=change-this-password
JWT_SECRET=change-this-to-a-random-string

# 可选:模型权重路径(默认 models/yolo_best.pt 与 models/sam2.1_t.pt)
# YOLO_WEIGHTS=models/yolo_best.pt
# SAM_WEIGHTS=models/sam2.1_t.pt

# 可选:SAM 分割输入分辨率。2 GiB 内存的云服务器建议保持 512。
# SAM_IMGSZ=512

# 可选:单张上传图片的最大体积(单位 MiB)。
# MAX_UPLOAD_MB=20

# 可选:queued/running 任务超过多少分钟后自动标记失败。
# STALE_JOB_MINUTES=30
